{
    "boot-source": {
        "kernel_image_path": "/opt/firecracker/vmlinux.bin",
        "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodule swiotlb=noforce random.trust_cpu=on i8042.noaux i8042.nomux i8042.dumbkbd ro"
    },
    "drives": [
        {
            "drive_id": "rootfs",
            "path_on_host": "/var/cache/aleph/runtime.squashfs",
            "is_root_device": true,
            "is_read_only": true
        },
        {
            "drive_id": "vdb",
            "path_on_host": "/var/cache/aleph/data.img",
            "is_root_device": false,
            "is_read_only": false
        }
    ],
    "machine-config": {
        "vcpu_count": 1,
        "mem_size_mib": 256,
        "smt": false
    },
    "vsock": {
        "vsock_id": "1",
        "guest_cid": 3,
        "uds_path": "/tmp/v.sock"
    },
    "network-interfaces": [
        {
            "iface_id": "eth0",
            "guest_mac": "AA:FC:00:00:00:01",
            "host_dev_name": "vmtap4"
        }
    ]
}